# WordPress headless CMS (vantico-cms plugin, /wp-json/vantico/v1)
# The only backend this site talks to.
NEXT_PUBLIC_CMS_URL=http://localhost:8080

# Optional: server-side override, for when the Next.js server must reach
# WordPress on a different host than the browser does. Left empty, the server
# uses NEXT_PUBLIC_CMS_URL.
CMS_URL=

# Shared secret for the "Refresh the website" button on the Site Options screen
# in wp-admin, which clears this site's page cache on demand.
#
# Must match VANTICO_REVALIDATE_SECRET in the WordPress wp-config.php. Leave it
# unset and /api/revalidate refuses every request rather than running unguarded.
# Server-only — never prefix this with NEXT_PUBLIC_.
REVALIDATE_SECRET=
